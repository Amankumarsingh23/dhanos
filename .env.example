# Copy this file to .env.local and fill in real values for local development.
# Never commit .env.local or any file containing real secrets.

# Public — safe to ship in the browser bundle (enforced by RLS on the Supabase side).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — bypasses Row Level Security. Never expose to the client bundle,
# never reference outside src/lib/env/server.ts or other server-only modules.
# See docs/security-model.md §3-4.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
